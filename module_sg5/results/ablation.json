  "stress_track": {
   "input": "module_sg5/fixtures/stress_track.json",
   "input_is_synthetic": true,
   "labelled": true,
   "headline": "Built by module_sg5/fixtures/stress_track.py to put each mechanism in a situation where it decides something.",
   "caveat": "Engineered to provoke, which makes it LESS like a real driver, not more. Every number here is about mechanism behaviour. The two fields set by design rather than derived are stated in the generator's docstring: `drowsy_score` is the fixture's control variable, and `low_coverage` reports a deliberately thin, unfilled window.",
   "frames": 975,
   "invalid_frames": 9,
   "clip_length_s": 32.4667,
   "closure_onset_s": 14.5,
   "genuine_spans_s": [
    [
     14.0,
     20.0
    ],
    [
     20.0,
     24.0
    ]
   ],
   "segments": [
    {
     "name": "awake_baseline",
     "start_s": 0.0,
     "end_s": 4.0,
     "targets": "nothing -- false-alarm denominator",
     "genuine_drowsy_episode": false,
     "rationale": "Alert driver, score 0.05, full confidence, two ordinary blinks. Any ALERT in here is a nuisance alert and nothing else."
    },
    {
     "name": "boundary_hover",
     "start_s": 4.0,
     "end_s": 10.0,
     "targets": "hysteresis (warn_off vs warn_on)",
     "genuine_drowsy_episode": false,
     "rationale": "Score alternates 0.47/0.43 in 0.5 s half-cycles -- slower than min_dwell_s, so the dwell timer cannot absorb it. With the dead band the state settles into WARN and stays; with warn_off == warn_on it flips on every half-cycle."
    },
    {
     "name": "recover_hover",
     "start_s": 10.0,
     "end_s": 11.0,
     "targets": "nothing -- returns every variant to a settled OK",
     "genuine_drowsy_episode": false,
     "rationale": "Needed because the variants leave boundary_hover in different states; without it the next segment would measure the carry-over."
    },
    {
     "name": "single_frame_spikes",
     "start_s": 11.0,
     "end_s": 14.0,
     "targets": "dwell timer (min_dwell_s)",
     "genuine_drowsy_episode": false,
     "rationale": "Baseline 0.05 with four isolated ONE-frame spikes to 0.95. A dwell timer swallows them; without it each spike is an alarm on an awake driver."
    },
    {
     "name": "genuine_episode",
     "start_s": 14.0,
     "end_s": 20.0,
     "targets": "alert latch (alert_latch_s), and the score path end to end",
     "genuine_drowsy_episode": true,
     "rationale": "A real episode: score climbs past alert_on, eyes close for 2.3 s of which SG-4 observes 2.0 s, then the face is lost for 0.3 s (16.50-16.80 s, valid=False, reason='no_valid_observations') while the alarm is live -- entirely inside the latch window, so the latch is the only thing holding the alarm up. Observation resumes with the eyes open: current_closure_s -> 0 while longest_closure_s keeps 2.0 for the rest of the window, exactly as SG-4 reports it. The score then decays through the WARN band to baseline."
    },
    {
     "name": "override_only",
     "start_s": 20.0,
     "end_s": 24.0,
     "targets": "sustained-closure override (closure_override_s)",
     "genuine_drowsy_episode": true,
     "rationale": "Eyes shut for 2.5 s while the score is held at 0.50, below alert_on. The window has just turned over, so PERCLOS has not caught up: the override is the only mechanism that can alarm here, and without it nothing does."
    },
    {
     "name": "recover_override",
     "start_s": 24.0,
     "end_s": 25.5,
     "targets": "nothing -- drains the latch and returns every variant to OK",
     "genuine_drowsy_episode": false,
     "rationale": "The confidence gate holds the CURRENT state rather than forcing OK, so low_coverage must start from a settled OK or it would measure the leftover WARN from override_only instead of the gate."
    },
    {
     "name": "low_coverage",
     "start_s": 25.5,
     "end_s": 29.5,
     "targets": "confidence gate (min_confidence)",
     "genuine_drowsy_episode": false,
     "rationale": "Confidence 0.30 on a 1.2 s unfilled window with PERCLOS 0.80 and a score of 0.80 -- a high score computed from roughly a dozen surviving observations. Thin evidence, not a real event: with the gate there is no escalation, without it there is an alarm."
    },
    {
     "name": "tail_awake",
     "start_s": 29.5,
     "end_s": 32.5,
     "targets": "nothing -- makes the final state observable",
     "genuine_drowsy_episode": false,
     "rationale": "Back to baseline so a configuration that never releases its alarm is visible as such instead of being hidden by the clip ending mid-alert."
    }
   ],
